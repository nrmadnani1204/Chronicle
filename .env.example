# Gemini access goes through Vertex AI + Application Default Credentials
# (ADC), not an AI Studio API key.
# Local dev: run `gcloud auth application-default login` once.
# Production (Cloud Run): ADC comes from the service's attached service
# account automatically — no credentials file needed there.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT="MY_GCP_PROJECT_ID"
GOOGLE_CLOUD_LOCATION="global"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIRESTORE_API_KEY: Firebase web config key (not a secret — Firestore
# Security Rules enforce access, not this key). Kept out of source control
# anyway. From Firebase Console > Project Settings > Your apps.
VITE_FIRESTORE_API_KEY="MY_FIRESTORE_API_KEY"

# Weekly Gmail digest (Cloud Scheduler -> POST /internal/weekly-digest).
# Run scripts/gmail_oauth_setup.py once to mint the OAuth values below for a
# dedicated sending account (not your own inbox). See README "Weekly Gmail
# Digest" section for full setup.
GMAIL_OAUTH_CLIENT_ID="MY_GMAIL_OAUTH_CLIENT_ID"
GMAIL_OAUTH_CLIENT_SECRET="MY_GMAIL_OAUTH_CLIENT_SECRET"
GMAIL_OAUTH_REFRESH_TOKEN="MY_GMAIL_OAUTH_REFRESH_TOKEN"
GMAIL_SENDER_ADDRESS="MY_GMAIL_SENDER_ADDRESS"

# Shared secret server.ts checks on the X-Internal-Secret header before
# proxying a weekly-digest trigger to the Python sidecar. Generate any long
# random string, e.g. `openssl rand -hex 32`.
INTERNAL_DIGEST_SECRET="MY_INTERNAL_DIGEST_SECRET"

# When true, the weekly digest job logs what it would send instead of
# actually sending via Gmail — safe for local testing.
DIGEST_DRY_RUN=true
